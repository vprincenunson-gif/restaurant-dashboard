generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  password     String?
  name         String
  role         String   @default("staff") // admin, manager, staff
  avatar       String?
  googleId     String?  @unique
  phone        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  staff        Staff?
  orders       Order[]
  sales        Sale[]
}

model Table {
  id          String   @id @default(cuid())
  number      Int      @unique
  capacity    Int      @default(4)
  status      String   @default("available") // available, occupied, reserved, maintenance
  location    String?  // window, indoor, outdoor, bar
  qrCode      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders      Order[]
}

model MenuCategory {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())

  items       MenuItem[]
}

model MenuItem {
  id          String        @id @default(cuid())
  name        String
  description String?
  price       Float
  cost        Float?
  categoryId  String
  category    MenuCategory  @relation(fields: [categoryId], references: [id])
  image       String?
  available   Boolean       @default(true)
  isPopular   Boolean       @default(false)
  prepTime    Int?          // minutes
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  orderItems  OrderItem[]
}

model Order {
  id           String      @id @default(cuid())
  orderNumber  Int         @default(autoincrement())
  tableId      String?
  table        Table?      @relation(fields: [tableId], references: [id])
  customerId   String?
  customer     Customer?   @relation(fields: [customerId], references: [id])
  userId       String?
  user         User?       @relation(fields: [userId], references: [id])
  status       String      @default("pending") // pending, confirmed, preparing, ready, served, completed, cancelled
  type         String      @default("dine-in") // dine-in, takeaway, delivery
  subtotal     Float       @default(0)
  tax          Float       @default(0)
  serviceCharge Float      @default(0)
  discount     Float       @default(0)
  total        Float       @default(0)
  notes        String?
  paymentMethod String?    // cash, card, upi, online
  paymentStatus String      @default("unpaid") // unpaid, paid, refunded
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  items        OrderItem[]
  sale         Sale?
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem  MenuItem @relation(fields: [menuItemId], references: [id])
  quantity  Int      @default(1)
  unitPrice Float
  subtotal  Float
  notes     String?
  status    String   @default("pending") // pending, preparing, ready, served
}

model Customer {
  id          String   @id @default(cuid())
  name        String
  email       String?  @unique
  phone       String?  @unique
  address     String?
  notes       String?
  totalVisits Int      @default(0)
  totalSpent  Float    @default(0)
  lastVisit   DateTime?
  isVip       Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders      Order[]
}

model Staff {
  id          String   @id @default(cuid())
  userId      String?  @unique
  user        User?    @relation(fields: [userId], references: [id])
  name        String
  email       String?  @unique
  phone       String?
  role        String   @default("waiter") // waiter, chef, manager, host, bartender, cleaner
  shift       String?  // morning, evening, night
  salary      Float?
  hourlyRate  Float?
  address     String?
  emergencyContact String?
  joinDate    DateTime @default(now())
  isActive    Boolean  @default(true)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model InventoryItem {
  id          String   @id @default(cuid())
  name        String
  sku         String?  @unique
  category    String   @default("other") // produce, meat, dairy, dry-goods, beverages, cleaning, other
  quantity    Float    @default(0)
  unit        String   @default("pcs") // pcs, kg, g, l, ml, bag, box, carton
  minStock    Float    @default(10)
  maxStock    Float?
  costPerUnit Float?
  supplier    String?
  location    String?  // storage area
  expiryDate  DateTime?
  notes       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Sale {
  id            String   @id @default(cuid())
  orderId       String?  @unique
  order         Order?   @relation(fields: [orderId], references: [id])
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  amount        Float
  paymentMethod String   @default("cash") // cash, card, upi, online
  status        String   @default("completed") // pending, completed, refunded
  transactionId String?
  notes         String?
  saleDate      DateTime @default(now())
  createdAt     DateTime @default(now())
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String   // create, update, delete, login, logout
  entity    String   // order, table, inventory, staff, customer, sale
  entityId  String?
  details   Json?
  createdAt DateTime @default(now())
}
